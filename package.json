{
  "name": "vitrinka-kit",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@vitrinka/*' build",
    "test": "bun run --filter '@vitrinka/*' test",
    "typecheck": "bun run --filter '@vitrinka/redact' build && bun run --filter '@vitrinka/*' typecheck",
    "test:e2e:web": "bun run --filter '@vitrinka/web' test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
