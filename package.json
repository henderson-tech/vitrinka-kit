{
  "name": "vitrinka-kit",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@vitrinka/*' build",
    "test": "bun run --filter '@vitrinka/*' test && bun run test:extension",
    "test:extension": "bun test apps/extension/content.test.js",
    "typecheck": "bun run --filter '@vitrinka/*' typecheck"
  }
}
